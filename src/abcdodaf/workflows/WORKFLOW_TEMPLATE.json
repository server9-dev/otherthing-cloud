{
  "_template": "BPMN 2.0 Agent Workflow Template for ABCDODAF Tasks",
  "_description": "Use this template to document agent task execution workflows",
  "_usage": "Copy this template and fill in the details for each agent task",

  "bpmn_process": {
    "id": "task_XX_descriptive_name",
    "name": "Task Name Here",
    "version": "1.0.0",
    "isExecutable": true,
    "processType": "agent_workflow"
  },

  "task_metadata": {
    "task_id": "XX",
    "agent_id": "agent_id_here",
    "model": "claude-haiku-3-5 or claude-sonnet-4-5",
    "status": "pending | in_progress | completed | failed",
    "started": "2026-01-27T06:00:00Z",
    "completed": "null or timestamp",
    "duration_minutes": "null or number",
    "priority": "high | medium_high | medium | low",
    "category": "core_functionality | developer_experience | advanced_features"
  },

  "dodaf_metadata": {
    "operational_activity": {
      "id": "OA-XXX",
      "name": "Activity_Name",
      "type": "Automated",
      "performer": "AI_Agent_Type",
      "security_domain": "Development",
      "cost": {
        "api_calls": 0,
        "tokens_consumed": 0,
        "estimated_usd": 0.0
      },
      "duration_minutes": 0
    },
    "capability": "Capability_Name",
    "inputs": ["input1", "input2"],
    "outputs": ["output1", "output2"]
  },

  "workflow_steps": [
    {
      "id": "start_event",
      "name": "Start Task",
      "type": "startEvent",
      "eventType": "none"
    },
    {
      "id": "research_step",
      "name": "Research and Analysis",
      "type": "serviceTask",
      "taskType": "research",
      "implementation": "research_method",
      "inputs": ["requirements"],
      "outputs": ["findings"],
      "duration_minutes": 0
    },
    {
      "id": "design_step",
      "name": "Design Architecture",
      "type": "serviceTask",
      "taskType": "design",
      "implementation": "architectural_design",
      "inputs": ["findings", "constraints"],
      "outputs": ["architecture"],
      "duration_minutes": 0
    },
    {
      "id": "implementation_step",
      "name": "Implement Components",
      "type": "serviceTask",
      "taskType": "code_generation",
      "implementation": "rust_code_generation",
      "inputs": ["architecture"],
      "outputs": ["code_modules"],
      "duration_minutes": 0,
      "files_created": []
    },
    {
      "id": "testing_step",
      "name": "Write and Run Tests",
      "type": "serviceTask",
      "taskType": "testing",
      "implementation": "test_generation_and_execution",
      "inputs": ["code_modules"],
      "outputs": ["test_results"],
      "duration_minutes": 0
    },
    {
      "id": "documentation_step",
      "name": "Write Documentation",
      "type": "serviceTask",
      "taskType": "documentation",
      "implementation": "doc_generation",
      "inputs": ["code_modules", "architecture"],
      "outputs": ["documentation"],
      "duration_minutes": 0
    },
    {
      "id": "end_event",
      "name": "Task Complete",
      "type": "endEvent",
      "eventType": "none"
    }
  ],

  "sequence_flows": [
    {"id": "flow1", "sourceRef": "start_event", "targetRef": "research_step"},
    {"id": "flow2", "sourceRef": "research_step", "targetRef": "design_step"},
    {"id": "flow3", "sourceRef": "design_step", "targetRef": "implementation_step"},
    {"id": "flow4", "sourceRef": "implementation_step", "targetRef": "testing_step"},
    {"id": "flow5", "sourceRef": "testing_step", "targetRef": "documentation_step"},
    {"id": "flow6", "sourceRef": "documentation_step", "targetRef": "end_event"}
  ],

  "expected_deliverables": {
    "modules": [
      "src/module_name/mod.rs",
      "src/module_name/component1.rs",
      "src/module_name/component2.rs"
    ],
    "tests": [
      "tests/module_test.rs"
    ],
    "documentation": [
      "docs/MODULE_GUIDE.md"
    ],
    "examples": [
      "examples/module_example.rs"
    ]
  },

  "dependencies": {
    "external_crates": [
      "crate1",
      "crate2"
    ],
    "internal_dependencies": [
      "existing_module1",
      "existing_module2"
    ]
  },

  "success_criteria": {
    "functional": [
      "Feature X works correctly",
      "Integration with Y successful",
      "Performance meets requirements"
    ],
    "quality": [
      "Test coverage > 80%",
      "Documentation complete",
      "Code follows Rust best practices",
      "No compiler warnings"
    ],
    "business_value": [
      "Enables capability X",
      "Improves Y",
      "Reduces Z"
    ]
  },

  "_gateway_patterns": {
    "exclusive_gateway": {
      "id": "decision_point",
      "name": "Decision Point",
      "type": "exclusiveGateway",
      "outgoing_flows": [
        {"condition": "condition1", "targetRef": "path1"},
        {"condition": "condition2", "targetRef": "path2"}
      ]
    },
    "parallel_gateway": {
      "split": {
        "id": "parallel_split",
        "type": "parallelGateway",
        "diverging": true
      },
      "join": {
        "id": "parallel_join",
        "type": "parallelGateway",
        "converging": true
      }
    }
  },

  "_common_task_types": {
    "research": "Research specifications, best practices, existing patterns",
    "design": "Architectural design, data structure design",
    "code_generation": "Write Rust code implementing the design",
    "testing": "Write and execute unit/integration tests",
    "documentation": "Write guides, references, API docs",
    "integration": "Integrate with existing systems",
    "debugging": "Fix issues found during testing",
    "optimization": "Improve performance or code quality"
  }
}
